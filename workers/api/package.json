{
  "name": "harfclub-api",
  "scripts": {
    "dev": "wrangler dev --port 8342",
    "deploy": "wrangler deploy",
    "db:init:remote": "wrangler d1 execute harfclub --remote --file=./src/schema.sql",
    "db:init:local": "wrangler d1 execute harfclub --local --file=./src/schema.sql",
    "db:seed:remote": "wrangler d1 execute harfclub --remote --file=./src/seed.sql",
    "db:seed:local": "wrangler d1 execute harfclub --local --file=./src/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply harfclub --remote",
    "db:migrate:local": "wrangler d1 migrations apply harfclub --local"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "wrangler": "^4.129.0"
  }
}