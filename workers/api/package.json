{
  "name": "bahsclub-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8342",
    "deploy": "wrangler deploy",
    "db:init:remote": "wrangler d1 execute bahsclub --remote --file=./src/schema.sql",
    "db:init:local": "wrangler d1 execute bahsclub --local --file=./src/schema.sql",
    "db:seed:remote": "wrangler d1 execute bahsclub --remote --file=./src/seed.sql",
    "db:seed:local": "wrangler d1 execute bahsclub --local --file=./src/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply bahsclub --remote",
    "db:migrate:local": "wrangler d1 migrations apply bahsclub --local",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}