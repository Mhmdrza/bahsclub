{
  "name": "bahsclub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run content:validate && next build",
    "start": "next start",
    "lint": "eslint",
    "content:index": "node scripts/build-manifest.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:check": "npm run content:index && npm run content:validate",
    "db:init:local": "npm --prefix workers/api run db:init:local",
    "db:seed": "npm --prefix workers/api run db:seed",
    "db:seed:local": "npm --prefix workers/api run db:seed:local",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
